{
  "title": "Jenkins Pipeline Health (Lab 09)",
  "uid": "lab09-jenkins",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["lab09", "jenkins", "slo"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Build success rate",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "sum(increase(jenkins_runs_success_total[$__range])) / sum(increase(jenkins_runs_total_total[$__range]))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 0.8 },
            { "color": "green", "value": 0.95 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 build duration (SLO: < 6 min)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(jenkins_job_building_duration{quantile=\"0.95\"})", "legendFormat": "p95" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line+area" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "red", "value": 360 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3, "type": "timeseries", "title": "Current queue length",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "jenkins_queue_size_value", "legendFormat": "queued items" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        },
        "overrides": []
      }
    },
    {
      "id": 4, "type": "timeseries", "title": "Queue wait p95 (alert: > 2 min for 5 min)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(jenkins_job_queuing_duration{quantile=\"0.95\"})", "legendFormat": "queue wait p95" },
        { "refId": "B", "expr": "ALERTS{alertname=\"JenkinsQueueBacklog\"}", "legendFormat": "alert {{alertstate}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "red", "value": 120 }
          ] }
        },
        "overrides": []
      }
    }
  ]
}
